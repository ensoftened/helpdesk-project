# Database
# For Docker: DATABASE_PROVIDER=postgresql and use DATABASE_URL below
# For local dev without Docker: DATABASE_PROVIDER=sqlite and use SQLITE_URL
DATABASE_PROVIDER=sqlite
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk
SQLITE_URL=file:./dev.db

# JWT secrets (change these in production!)
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:5173